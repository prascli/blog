{
  "name": "qansa-engineering-journal",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Indra Prasetya \u2014 Engineering Journal. Static publication built with Astro on AstroPaper.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagrams": "node scripts/render-diagrams.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:ci": "playwright test --reporter=line",
    "lighthouse": "node scripts/lighthouse.mjs",
    "diagrams:check": "node scripts/check-diagram-bounds.mjs",
    "pages:check": "node scripts/check-pages-limits.mjs dist",
    "pages:usage": "node scripts/check-pages-limits.mjs usage"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "dayjs": "^1.11.23",
    "rehype-callouts": "^2.2.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.10.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@pagefind/default-ui": "^1.6.0",
    "@playwright/test": "^1.56.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.0.0",
    "pagefind": "^1.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0"
}

---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { categoryLabel, categoryUrl } from "@/utils/categories";
import { readingTimeLabel } from "@/utils/postMeta";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  /** Hide the category kicker when the surrounding page already names it. */
  hideCategory?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  hideCategory = false,
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, category, tags, ...props } = data;
---

<li class="border-border group border-b py-7 first:pt-0 last:border-b-0">
  <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
    {!hideCategory && (
      <>
        <a
          href={categoryUrl(category)}
          class="kicker hover:text-accent transition-colors"
        >
          {categoryLabel(category)}
        </a>
        <span aria-hidden="true" class="text-muted-foreground text-xs">
          /
        </span>
      </>
    )}
    <Datetime {...props} />
    <span aria-hidden="true" class="text-muted-foreground text-xs">
      /
    </span>
    <span class="text-muted-foreground text-xs">{readingTimeLabel(body)}</span>
  </div>

  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="text-foreground focus-visible:no-underline"
  >
    <Heading
      transition:name={toTransitionName(id)}
      class="group-hover:text-accent text-xl leading-snug font-medium transition-colors sm:text-2xl"
    >
      {title}
    </Heading>
  </a>

  <p class="text-muted-foreground mt-2 text-[15px] leading-relaxed">
    {description}
  </p>

  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
      {tags.map(tag => (
        <li class="text-muted-foreground font-mono text-xs">#{tag}</li>
      ))}
    </ul>
  )}
</li>

---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, categoryUrl } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Only surface categories that actually have published articles.
const usedCategories = CATEGORIES.map(category => ({
  ...category,
  count: posts.filter(post => post.data.category === category.slug).length,
})).filter(category => category.count > 0);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-12 pb-10 sm:pt-16">
      <p class="kicker">Systems, data, infrastructure, agent tooling</p>
      <h1 class="mt-4 text-4xl leading-[1.1] sm:text-5xl">
        {config.site.author}
      </h1>
      <p class="text-muted-foreground mt-5 max-w-xl text-lg leading-relaxed">
        Building reliable systems. Measuring what matters. Sharing what works.
      </p>
      <p class="mt-4 max-w-xl text-[15px] leading-relaxed">
        Senior software engineer working on backend services, databases,
        infrastructure, and the tooling around AI coding agents. Everything here
        comes from a system I run, a failure I fixed, or a measurement I can
        reproduce.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-accent hover:text-accent/80 inline-flex items-center gap-1.5 font-medium"
        >
          Read the writing
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-muted-foreground hover:text-accent"
        >
          About
        </LinkButton>
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="text-muted-foreground hover:text-accent inline-flex items-center gap-1.5"
        >
          <IconRss class="size-4 stroke-current stroke-2" />
          RSS
        </a>
      </div>
    </section>

    {usedCategories.length > 0 && (
      <section id="categories" class="border-border border-b py-7">
        <h2 class="kicker mb-4">{t.home.categories}</h2>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {usedCategories.map(category => (
            <li>
              <a
                href={categoryUrl(category.slug)}
                class="text-muted-foreground hover:text-accent transition-colors"
              >
                {category.label}
                <span class="text-muted-foreground ms-1 font-mono text-xs">
                  {category.count}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {featuredPosts.length > 0 && (
      <section id="featured" class="border-border border-b py-10">
        <h2 class="kicker mb-5">{t.home.featured}</h2>
        <ul>
          {featuredPosts.map(post => (
            <Card {...post} variant="h3" />
          ))}
        </ul>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="py-10">
        <h2 class="kicker mb-5">{t.home.recentPosts}</h2>
        <ul>
          {recentPosts.slice(0, postsConfig.perIndex).map(post => (
            <Card {...post} variant="h3" />
          ))}
        </ul>
      </section>
    )}

    <div class="my-10">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="text-muted-foreground hover:text-accent inline-flex items-center gap-1.5 text-sm font-medium"
      >
        {t.home.allPosts}
        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
